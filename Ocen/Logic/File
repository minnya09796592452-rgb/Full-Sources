		if (!m_cameraData.TryGetValue(cam, out value))
		{
			value = new CameraData();
			m_cameraData.Add(cam, value);
		}
		if (value.settings == null && !value.checkedForSettings)
		{
			value.settings = cam.GetComponent<OceanCameraSettings>();
