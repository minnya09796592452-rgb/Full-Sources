	public Vector3 CalculateWindDirVector()
	{
		float f = windDir * MathF.PI / 180f;
		float x = 0f - Mathf.Cos(f);
		float z = Mathf.Sin(f);
		return new Vector3(x, 0f, z).normalized;
	}

