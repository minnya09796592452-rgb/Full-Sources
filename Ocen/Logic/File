			Vector4 value2 = new Vector4
			{
				x = ((foamTexture0.scale.x != 0f) ? (1f / foamTexture0.scale.x) : 1f),
				y = ((foamTexture0.scale.y != 0f) ? (1f / foamTexture0.scale.y) : 1f),
				z = foamTexture0.scrollSpeed * OceanTime.Now,
